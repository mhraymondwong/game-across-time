; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="時光裡的她"
config/description="原創養成遊戲：父親與女兒在溫馨小鎮度過十二年"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
; Diary-cover loading screen. PNG only; stretch_mode 1 = Keep (1280×720, no crop).
boot_splash/bg_color=Color(0.93333334, 0.88235295, 0.79607844, 1)
boot_splash/image="res://assets/boot_splash.png"
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

GameState="*res://scripts/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"


[gui]

theme/custom_font="res://assets/fonts/NotoSansCJKtc-Regular.otf"

[internationalization]

locale/fallback="zh_Hant"

[rendering]

renderer/rendering_method="gl_compatibility"
